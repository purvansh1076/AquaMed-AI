# ─────────────────────────────────────────────────────────────────────────────
# AquaMediAI — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://aquamedi:aquamedi_secret@localhost:5432/aquamedi_db

# ─── PostgreSQL (used by docker-compose) ──────────────────────────────────────
POSTGRES_USER=aquamedi
POSTGRES_PASSWORD=aquamedi_secret
POSTGRES_DB=aquamedi_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── ML / Data ────────────────────────────────────────────────────────────────
# Random seed for reproducible synthetic data generation and model training
RANDOM_SEED=42
# Path where trained model artifacts are saved
MODEL_DIR=data/models
# Path where synthetic datasets are saved
DATA_DIR=data/raw

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
